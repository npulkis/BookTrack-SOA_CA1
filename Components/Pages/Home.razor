@page "/"
@rendermode InteractiveServer
@attribute [StreamRendering]
@using BookTrack.Models
@using BookTrack.Services
@inject OpenLibraryService OpenLibraryService
@inject ReadingListService ReadingListService

<PageTitle>Book Search</PageTitle>

<h1>Book search</h1>

<form class="mb-4" @onsubmit="SearchBooksAsync" @onsubmit:preventDefault="true">
    <label class="form-label" for="search-field">Search by</label>
    <div class="input-group">
        <select id="search-field" class="form-select" @bind="searchField" aria-label="Search by">
            <option value="title">Title</option>
            <option value="author">Author</option>
        </select>
        <input id="book-search"
               class="form-control"
               type="search"
               placeholder="@SearchPlaceholder"
               aria-label="Search term"
               @bind="searchQuery" />
        <button class="btn btn-primary" type="submit" disabled="@isLoading">Search</button>
    </div>
</form>


@if (isLoading)
{
    <p>Loading…</p>
}
else if (errorMessage is not null)
{
    <p>@errorMessage</p>
}
else if (!hasSearched)
{
    <p>Enter a book title to see results.</p>
}
else
{
    <h2>Results</h2>
    @if (books.Count == 0)
    {
        <p>No books found.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var book in books)
            {
                <div class="col">
                    <article class="card h-100">
                        @if (book.CoverId is not null)
                        {
                            <img class="card-img-top book-cover"
                                 src="https://covers.openlibrary.org/b/id/@(book.CoverId)-M.jpg?default=false"
                                 alt="Cover of @book.Title"
                                 loading="lazy" />
                        }
                        <div class="card-body">
                            <h2 class="h5 card-title">@(book.Title ?? "Untitled")</h2>
                            <p class="card-text">
                                @(book.Authors.Count > 0 ? string.Join(", ", book.Authors) : "Author not listed")
                            </p>
                            @if (!string.IsNullOrWhiteSpace(book.Key))
                            {
                                <a class="btn btn-outline-primary" href="@DetailsUrl(book)">View details</a>
                                <button class="btn btn-primary ms-2"
                                        @onclick="() => AddToReadingListAsync(book)"
                                        disabled="@(isLoadingReadingList || isSavingReadingList || ReadingListService.Contains(book))">
                                    @(ReadingListService.Contains(book) ? "Added" : "Add to reading list")
                                </button>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
}

@code {
    private string searchQuery = string.Empty;
    private string searchField = "title";
    private List<OpenLibraryBook> books = [];
    private bool isLoading;
    private bool hasSearched;
    private string? errorMessage;
    private bool isLoadingReadingList = true;
    private bool isSavingReadingList;
    private string? readingListError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReadingListService.LoadAsync();
        }
        catch (System.Text.Json.JsonException)
        {
            readingListError = "The saved reading list contains data the app could not read.";
        }
        catch (IOException)
        {
            readingListError = "The saved reading list could not be opened.";
        }
        catch (UnauthorizedAccessException)
        {
            readingListError = "The app does not have permission to read the saved reading list.";
        }
        finally
        {
            isLoadingReadingList = false;
        }
    }

    private Task AddToReadingListAsync(OpenLibraryBook book)
    {
        return UpdateReadingListAsync(() => ReadingListService.AddAsync(book));
    }

    private async Task UpdateReadingListAsync(Func<Task> update)
    {
        isSavingReadingList = true;
        readingListError = null;
        try
        {
            await update();
        }
        catch (System.Text.Json.JsonException)
        {
            readingListError = "The saved reading list contains data the app could not read.";
        }
        catch (IOException)
        {
            readingListError = "The saved reading list could not be saved.";
        }
        catch (UnauthorizedAccessException)
        {
            readingListError = "The app does not have permission to save the reading list.";
        }
        finally
        {
            isSavingReadingList = false;
        }
    }

    // Search Open Library with the title entered in the form.
    private async Task SearchBooksAsync()
    {
        hasSearched = true;
        var query = searchQuery.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            // Ask for a search term before sending the request.
            books = [];
            errorMessage = "Enter a search term.";
            isLoading = false;
            return;
        }

        searchQuery = query;
        isLoading = true;
        errorMessage = null;

        try
        {
            books = await OpenLibraryService.SearchBooksAsync(query, searchField);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Open Library could not be reached. Check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The Open Library request timed out. Please try again later.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "Open Library returned data the app could not read.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string SearchPlaceholder => searchField == "author"
        ? "Enter an author name"
        : "Enter a book title";

    private static string DetailsUrl(OpenLibraryBook book)
    {
        var workId = book.Key?.Split('/').LastOrDefault();
        if (string.IsNullOrWhiteSpace(workId))
        {
            return "/";
        }

        var url = $"/book/{Uri.EscapeDataString(workId)}";
        if (book.Authors.Count > 0)
        {
            url += $"?authors={Uri.EscapeDataString(string.Join(", ", book.Authors))}";
        }

        if (book.FirstPublishYear is not null)
        {
            url += url.Contains('?') ? "&" : "?";
            url += $"firstPublishYear={book.FirstPublishYear}";
        }

        return url;
    }
}
