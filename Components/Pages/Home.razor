@page "/"
@attribute [StreamRendering]
@using System.Text.Json.Serialization
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Open Library Test</PageTitle>

<h1>Open Library test</h1>
<p>Hardcoded title search: <strong>@SearchTitle</strong></p>

@if (isLoading)
{
    <p>Loading…</p>
}
else if (errorMessage is not null)
{
    <p>@errorMessage</p>
}
else
{
    <h2>Results</h2>
    @if (books.Count == 0)
    {
        <p>No books found.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var book in books)
            {
                <div class="col">
                    <article class="card h-100">
                        @if (book.CoverId is not null)
                        {
                            <img class="card-img-top book-cover"
                                 src="https://covers.openlibrary.org/b/id/@(book.CoverId)-M.jpg?default=false"
                                 alt="Cover of @book.Title"
                                 loading="lazy" />
                        }
                        <div class="card-body">
                            <h2 class="h5 card-title">@(book.Title ?? "Untitled")</h2>
                            <p class="card-text">
                                @(book.Authors.Count > 0 ? string.Join(", ", book.Authors) : "Author not listed")
                            </p>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
}

@code {
    private const string SearchTitle = "Harry Potter";
    private List<BookResult> books = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("OpenLibrary");
            var encodedTitle = Uri.EscapeDataString(SearchTitle);
            var response = await client.GetFromJsonAsync<SearchResponse>(
                $"search.json?title={encodedTitle}&limit=5&fields=title,author_name,cover_i");
            books = response?.Books ?? [];
        }
        catch (HttpRequestException)
        {
            errorMessage = "Open Library could not be reached. Check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The Open Library request timed out. Please try again later.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "Open Library returned data the app could not read.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class SearchResponse
    {
        [JsonPropertyName("docs")]
        public List<BookResult> Books { get; init; } = [];
    }

    private sealed class BookResult
    {
        [JsonPropertyName("title")]
        public string? Title { get; init; }

        [JsonPropertyName("author_name")]
        public List<string> Authors { get; init; } = [];

        [JsonPropertyName("cover_i")]
        public int? CoverId { get; init; }
    }
}
