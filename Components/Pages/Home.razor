@page "/"
@rendermode InteractiveServer
@attribute [StreamRendering]
@using BookTrack.Models
@using BookTrack.Services
@inject OpenLibraryService OpenLibraryService
@inject ReadingListService ReadingListService

<PageTitle>Book Search</PageTitle>

<h1>Book search</h1>

<form class="mb-4" @onsubmit="SearchBooksAsync" @onsubmit:preventDefault="true">
    <label class="form-label" for="book-search">Search by title</label>
    <div class="input-group">
        <input id="book-search" class="form-control" type="search" @bind="searchTitle" />
        <button class="btn btn-primary" type="submit" disabled="@isLoading">Search</button>
    </div>
</form>

<section class="mb-4">
    <h2>My reading list</h2>
    @if (ReadingListService.Entries.Count == 0)
    {
        <p>No books saved yet.</p>
    }
    else
    {
        <ul>
            @foreach (var entry in ReadingListService.Entries)
            {
                <li>
                    @(entry.Book.Title ?? "Untitled")
                    @if (entry.Book.Authors.Count > 0)
                    {
                        <span>by @string.Join(", ", entry.Book.Authors)</span>
                    }
                    <div class="d-flex gap-2 mt-2">
                        <select class="form-select w-auto" @bind="entry.Status" aria-label="Reading status">
                            <option value="@ReadingStatus.WantToRead">Want to read</option>
                            <option value="@ReadingStatus.Reading">Reading</option>
                            <option value="@ReadingStatus.Finished">Finished</option>
                        </select>
                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="() => ReadingListService.Remove(entry)">
                            Remove
                        </button>
                    </div>
                </li>
            }
        </ul>
    }
</section>

@if (isLoading)
{
    <p>Loading…</p>
}
else if (errorMessage is not null)
{
    <p>@errorMessage</p>
}
else if (!hasSearched)
{
    <p>Enter a book title to see results.</p>
}
else
{
    <h2>Results</h2>
    @if (books.Count == 0)
    {
        <p>No books found.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var book in books)
            {
                <div class="col">
                    <article class="card h-100">
                        @if (book.CoverId is not null)
                        {
                            <img class="card-img-top book-cover"
                                 src="https://covers.openlibrary.org/b/id/@(book.CoverId)-M.jpg?default=false"
                                 alt="Cover of @book.Title"
                                 loading="lazy" />
                        }
                        <div class="card-body">
                            <h2 class="h5 card-title">@(book.Title ?? "Untitled")</h2>
                            <p class="card-text">
                                @(book.Authors.Count > 0 ? string.Join(", ", book.Authors) : "Author not listed")
                            </p>
                            @if (!string.IsNullOrWhiteSpace(book.Key))
                            {
                                <a class="btn btn-outline-primary" href="@DetailsUrl(book)">View details</a>
                                <button class="btn btn-primary ms-2"
                                        @onclick="() => ReadingListService.Add(book)"
                                        disabled="@ReadingListService.Contains(book)">
                                    @(ReadingListService.Contains(book) ? "Added" : "Add to reading list")
                                </button>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
}

@code {
    private string searchTitle = string.Empty;
    private List<OpenLibraryBook> books = [];
    private bool isLoading;
    private bool hasSearched;
    private string? errorMessage;

    // Search Open Library with the title entered in the form.
    private async Task SearchBooksAsync()
    {
        hasSearched = true;
        var title = searchTitle.Trim();
        if (string.IsNullOrWhiteSpace(title))
        {
            // Ask for a title before sending the request.
            books = [];
            errorMessage = "Enter a book title to search.";
            isLoading = false;
            return;
        }

        searchTitle = title;
        isLoading = true;
        errorMessage = null;

        try
        {
            books = await OpenLibraryService.SearchBooksAsync(title);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Open Library could not be reached. Check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The Open Library request timed out. Please try again later.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "Open Library returned data the app could not read.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string DetailsUrl(OpenLibraryBook book)
    {
        var workId = book.Key?.Split('/').LastOrDefault();
        if (string.IsNullOrWhiteSpace(workId))
        {
            return "/";
        }

        var url = $"/book/{Uri.EscapeDataString(workId)}";
        if (book.Authors.Count > 0)
        {
            url += $"?authors={Uri.EscapeDataString(string.Join(", ", book.Authors))}";
        }

        if (book.FirstPublishYear is not null)
        {
            url += url.Contains('?') ? "&" : "?";
            url += $"firstPublishYear={book.FirstPublishYear}";
        }

        return url;
    }
}
