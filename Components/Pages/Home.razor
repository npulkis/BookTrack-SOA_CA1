@page "/"
@rendermode InteractiveServer
@attribute [StreamRendering]
@using BookTrack.Models
@using BookTrack.Services
@inject OpenLibraryService OpenLibraryService
@inject BigBookApiService BigBookApiService
@inject ReadingListService ReadingListService

<PageTitle>Book Search</PageTitle>

<h1>Book search</h1>

<form class="mb-4" @onsubmit="SearchBooksAsync" @onsubmit:preventDefault="true">
    <label class="form-label" for="search-field">Search type</label>
    <div class="input-group">
        <select id="search-field" class="form-select" @bind="searchField" aria-label="Search by">
            <option value="title">Title</option>
            <option value="author">Author</option>
            <option value="natural">Describe a book</option>
        </select>
        <input id="book-search"
               class="form-control"
               type="search"
               aria-label="Search term or book description"
               @bind="searchQuery" />
        <button class="btn btn-primary" type="submit" disabled="@isLoading">Search</button>
    </div>
</form>


@if (isLoading)
{
    <p>Loading…</p>
}
else if (errorMessage is not null)
{
    <p>@errorMessage</p>
}
else if (!hasSearched)
{
        <p>Search by title, author, or describe the kind of book you’re looking for.</p>
}
else
{
    <h2>Results</h2>
    @if (searchResults.Count == 0)
    {
        <p>No books found.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var book in searchResults)
            {
                <div class="col">
                    <article class="card h-100">
                        @if (!string.IsNullOrWhiteSpace(book.CoverUrl))
                        {
                            <img class="card-img-top book-cover"
                                 src="@book.CoverUrl"
                                 alt="Cover of @(book.Title ?? "book")"
                                 loading="lazy" />
                        }
                        <div class="card-body">
                            <h2 class="h5 card-title">@(book.Title ?? "Untitled")</h2>
                            <p class="card-text">
                            @(book.Authors.Count > 0 ? string.Join(", ", book.Authors) : "Author not listed")
                            </p>
                            @if (book.OpenLibraryBook is not null && !string.IsNullOrWhiteSpace(book.OpenLibraryBook.Key))
                            {
                                <a class="btn btn-outline-primary" href="@DetailsUrl(book.OpenLibraryBook)">View details</a>
                                <button class="btn btn-primary ms-2"
                                        @onclick="() => AddToReadingListAsync(book.OpenLibraryBook)"
                                        disabled="@(isLoadingReadingList || isSavingReadingList || ReadingListService.Contains(book.OpenLibraryBook))">
                                    @(ReadingListService.Contains(book.OpenLibraryBook) ? "Added" : "Add to reading list")
                                </button>
                            }
                            else if (book.BigBookBook is not null)
                            {
                                <button class="btn btn-primary"
                                        @onclick="() => AddBigBookToReadingListAsync(book.BigBookBook)"
                                        disabled="@(isLoadingReadingList || isSavingReadingList || isAddingBigBook)">
                                    Add to reading list
                                </button>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
}

@code {
    private string searchQuery = string.Empty;
    private string searchField = "title";
    private List<BookSearchResult> searchResults = [];
    private bool isLoading;
    private bool hasSearched;
    private string? errorMessage;
    private bool isLoadingReadingList = true;
    private bool isSavingReadingList;
    private string? readingListError;
    private bool isAddingBigBook;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReadingListService.LoadAsync();
        }
        catch (System.Text.Json.JsonException)
        {
            readingListError = "The saved reading list contains data the app could not read.";
        }
        catch (IOException)
        {
            readingListError = "The saved reading list could not be opened.";
        }
        catch (UnauthorizedAccessException)
        {
            readingListError = "The app does not have permission to read the saved reading list.";
        }
        finally
        {
            isLoadingReadingList = false;
        }
    }

    private Task AddToReadingListAsync(OpenLibraryBook book)
    {
        return UpdateReadingListAsync(() => ReadingListService.AddAsync(book));
    }

    private async Task AddBigBookToReadingListAsync(BigBookBook book)
    {
        isAddingBigBook = true;
        errorMessage = null;
        try
        {
            var details = await BigBookApiService.GetBookAsync(book.Id);
            var workId = details?.Identifiers?.OpenLibraryId;
            if (string.IsNullOrWhiteSpace(workId))
            {
                errorMessage = "This book does not have an Open Library record, so it cannot be added yet.";
                return;
            }

            var libraryBook = new OpenLibraryBook
            {
                Key = $"/works/{workId}",
                Title = details.Title ?? book.Title,
                Authors = (details.Authors.Count > 0 ? details.Authors : book.Authors)
                    .Where(author => !string.IsNullOrWhiteSpace(author.Name))
                    .Select(author => author.Name!)
                    .ToList(),
                CoverId = ReadCoverId(details.Image ?? book.Image)
            };
            await AddToReadingListAsync(libraryBook);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Big Book API could not be reached. Check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The Big Book API request timed out. Please try again later.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "Big Book API returned data the app could not read.";
        }
        finally
        {
            isAddingBigBook = false;
        }
    }

    private async Task UpdateReadingListAsync(Func<Task> update)
    {
        isSavingReadingList = true;
        readingListError = null;
        try
        {
            await update();
        }
        catch (System.Text.Json.JsonException)
        {
            readingListError = "The saved reading list contains data the app could not read.";
        }
        catch (IOException)
        {
            readingListError = "The saved reading list could not be saved.";
        }
        catch (UnauthorizedAccessException)
        {
            readingListError = "The app does not have permission to save the reading list.";
        }
        finally
        {
            isSavingReadingList = false;
        }
    }

    // Search Open Library with the title entered in the form.
    private async Task SearchBooksAsync()
    {
        hasSearched = true;
        var query = searchQuery.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            // Ask for a search term before sending the request.
            searchResults = [];
            errorMessage = "Enter a search term.";
            isLoading = false;
            return;
        }

        searchQuery = query;
        isLoading = true;
        errorMessage = null;

        try
        {
            if (searchField == "natural")
            {
                if (!BigBookApiService.HasApiKey)
                {
                    errorMessage = "Add your Big Book API key to user secrets to use natural-language search.";
                    return;
                }

                var results = await BigBookApiService.SearchBooksAsync(query);
                searchResults = results.Select(book => new BookSearchResult(
                    book.Title,
                    book.Authors.Where(author => !string.IsNullOrWhiteSpace(author.Name))
                        .Select(author => author.Name!)
                        .ToList(),
                    book.Image,
                    BigBookBook: book)).ToList();
            }
            else
            {
                var results = await OpenLibraryService.SearchBooksAsync(query, searchField);
                searchResults = results.Select(book => new BookSearchResult(
                    book.Title,
                    book.Authors,
                    book.CoverId is null ? null : $"https://covers.openlibrary.org/b/id/{book.CoverId}-M.jpg?default=false",
                    OpenLibraryBook: book)).ToList();
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = searchField == "natural"
                ? "Big Book API could not be reached. Check your connection and try again."
                : "Open Library could not be reached. Check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = searchField == "natural"
                ? "The Big Book API request timed out. Please try again later."
                : "The Open Library request timed out. Please try again later.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = searchField == "natural"
                ? "Big Book API returned data the app could not read."
                : "Open Library returned data the app could not read.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static int? ReadCoverId(string? imageUrl)
    {
        if (!Uri.TryCreate(imageUrl, UriKind.Absolute, out var uri))
        {
            return null;
        }

        var id = uri.AbsolutePath.Split('/').LastOrDefault()?.Split('-').FirstOrDefault();
        return int.TryParse(id, out var coverId) ? coverId : null;
    }

    private static string DetailsUrl(OpenLibraryBook book)
    {
        var workId = book.Key?.Split('/').LastOrDefault();
        if (string.IsNullOrWhiteSpace(workId))
        {
            return "/";
        }

        var url = $"/book/{Uri.EscapeDataString(workId)}";
        if (book.Authors.Count > 0)
        {
            url += $"?authors={Uri.EscapeDataString(string.Join(", ", book.Authors))}";
        }

        if (book.FirstPublishYear is not null)
        {
            url += url.Contains('?') ? "&" : "?";
            url += $"firstPublishYear={book.FirstPublishYear}";
        }

        return url;
    }
}
