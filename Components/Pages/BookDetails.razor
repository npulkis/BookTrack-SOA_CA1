@page "/book/{WorkId}"
@rendermode InteractiveServer
@attribute [StreamRendering]
@using BookTrack.Models
@using BookTrack.Services
@using Microsoft.AspNetCore.Components
@inject OpenLibraryService OpenLibraryService
@inject BigBookApiService BigBookApiService

<PageTitle>@(Title ?? "Book details")</PageTitle>

<a href="/">← Back to results</a>

@if (isLoading)
{
    <p>Loading book details…</p>
}
else if (errorMessage is not null)
{
    <p role="alert">@errorMessage</p>
}
else if (work is not null)
{
    <main class="book-details">
        @if (CoverId is not null)
        {
            <img class="book-detail-cover"
                 src="https://covers.openlibrary.org/b/id/@(CoverId)-L.jpg?default=false"
                 alt="Cover of @Title"
                 loading="lazy" />
        }

        <h1>@(Title ?? "Untitled")</h1>

        @if (!string.IsNullOrWhiteSpace(AuthorNames))
        {
            <p><strong>Author(s):</strong> @AuthorNames</p>
        }
        @if (FirstPublishYear is not null)
        {
            <p><strong>First published:</strong> @FirstPublishYear</p>
        }
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <section>
                <h2>Description</h2>
                <p>@Description</p>
            </section>
        }
        @if (Subjects.Count > 0)
        {
            <section>
                <h2>Subjects</h2>
                <p>@string.Join(", ", Subjects.Take(8))</p>
            </section>
        }

        @if (BigBookApiService.HasApiKey)
        {
            <section>
                <h2>Books with similar themes</h2>
                @if (isLoadingSimilar)
                {
                    <p>Finding similar books…</p>
                }
                else if (similarErrorMessage is not null)
                {
                    <p role="status">@similarErrorMessage</p>
                }
                else if (similarBooks.Count == 0)
                {
                    <p>No similar books found.</p>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                        @foreach (var similarBook in similarBooks)
                        {
                            <div class="col">
                                <article class="card h-100">
                                    @if (!string.IsNullOrWhiteSpace(similarBook.Image))
                                    {
                                        <img class="card-img-top book-cover"
                                             src="@similarBook.Image"
                                             alt="Cover of @(similarBook.Title ?? "book")"
                                             loading="lazy" />
                                    }
                                    <div class="card-body">
                                        <h3 class="h5 card-title">@(similarBook.Title ?? "Untitled")</h3>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
            </section>
        }

        <p class="mt-3">
            <a href="https://openlibrary.org/works/@WorkId" target="_blank" rel="noopener noreferrer">
                Open Library record
            </a>
        </p>
    </main>
}

@code {
    [Parameter]
    public string WorkId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "authors")]
    public string? AuthorNames { get; set; }

    [SupplyParameterFromQuery(Name = "firstPublishYear")]
    public int? FirstPublishYear { get; set; }

    private OpenLibraryWork? work;
    private bool isLoading = true;
    private string? errorMessage;
    private List<BigBookSimilarBook> similarBooks = [];
    private bool isLoadingSimilar;
    private string? similarErrorMessage;

    private string? Title => work?.Title;
    private string? Description => work?.Description;
    private List<string> Subjects => work?.Subjects ?? [];
    private int? CoverId => work?.CoverId;

    protected override async Task OnParametersSetAsync()
    {
        work = null;
        isLoading = true;
        errorMessage = null;
        similarBooks = [];
        similarErrorMessage = null;
        isLoadingSimilar = BigBookApiService.HasApiKey;

        try
        {
            work = await OpenLibraryService.GetWorkAsync(WorkId);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Open Library could not be reached. Check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The Open Library request timed out. Please try again later.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "Open Library returned data the app could not read.";
        }
        finally
        {
            isLoading = false;
        }

        if (work is not null && isLoadingSimilar)
        {
            _ = LoadSimilarBooksAsync(WorkId, work.Title);
        }
    }

    private async Task LoadSimilarBooksAsync(string requestedWorkId, string? title)
    {
        try
        {
            var results = await BigBookApiService.GetThemeRelatedBooksAsync(title, Description, Subjects);
            if (WorkId == requestedWorkId)
            {
                similarBooks = results;
            }
        }
        catch (HttpRequestException)
        {
            if (WorkId == requestedWorkId)
            {
                similarErrorMessage = "Similar books could not be loaded. Check your connection and try again.";
            }
        }
        catch (TaskCanceledException)
        {
            if (WorkId == requestedWorkId)
            {
                similarErrorMessage = "The similar-books request timed out. Please try again later.";
            }
        }
        catch (System.Text.Json.JsonException)
        {
            if (WorkId == requestedWorkId)
            {
                similarErrorMessage = "Big Book API returned data the app could not read.";
            }
        }
        finally
        {
            if (WorkId == requestedWorkId)
            {
                isLoadingSimilar = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }
}
