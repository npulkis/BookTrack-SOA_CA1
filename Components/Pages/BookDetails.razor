@page "/book/{WorkId}"
@attribute [StreamRendering]
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@inject IHttpClientFactory HttpClientFactory

<PageTitle>@(Title ?? "Book details")</PageTitle>

<a href="/">← Back to results</a>

@if (isLoading)
{
    <p>Loading book details…</p>
}
else if (errorMessage is not null)
{
    <p role="alert">@errorMessage</p>
}
else if (workRecord is not null)
{
    <main class="book-details">
        @if (CoverId is not null)
        {
            <img class="book-detail-cover"
                 src="https://covers.openlibrary.org/b/id/@(CoverId)-L.jpg?default=false"
                 alt="Cover of @Title"
                 loading="lazy" />
        }

        <h1>@(Title ?? "Untitled")</h1>

        @if (!string.IsNullOrWhiteSpace(AuthorNames))
        {
            <p><strong>Author(s):</strong> @AuthorNames</p>
        }
        @if (FirstPublishYear is not null)
        {
            <p><strong>First published:</strong> @FirstPublishYear</p>
        }
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <section>
                <h2>Description</h2>
                <p>@Description</p>
            </section>
        }
        @if (Subjects.Count > 0)
        {
            <section>
                <h2>Subjects</h2>
                <p>@string.Join(", ", Subjects.Take(8))</p>
            </section>
        }

        <p class="mt-3">
            <a href="https://openlibrary.org/works/@WorkId" target="_blank" rel="noopener noreferrer">
                Open Library record
            </a>
        </p>
    </main>
}

@code {
    [Parameter]
    public string WorkId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "authors")]
    public string? AuthorNames { get; set; }

    [SupplyParameterFromQuery(Name = "firstPublishYear")]
    public int? FirstPublishYear { get; set; }

    private JsonDocument? workRecord;
    private bool isLoading = true;
    private string? errorMessage;

    private string? Title => ReadString("title");
    private string? Description => ReadDescription();
    private List<string> Subjects => ReadStringArray("subjects");
    private int? CoverId
    {
        get
        {
            var covers = ReadIntegerArray("covers");
            return covers.Count > 0 ? covers[0] : null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        workRecord?.Dispose();
        workRecord = null;
        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("OpenLibrary");
            var encodedWorkId = Uri.EscapeDataString(WorkId);
            // Load the full shared record for the selected book.
            var json = await client.GetStringAsync($"works/{encodedWorkId}.json");
            workRecord = JsonDocument.Parse(json);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Open Library could not be reached. Check your connection and try again.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The Open Library request timed out. Please try again later.";
        }
        catch (JsonException)
        {
            errorMessage = "Open Library returned data the app could not read.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string? ReadString(string propertyName)
    {
        if (workRecord?.RootElement.TryGetProperty(propertyName, out var value) != true)
        {
            return null;
        }

        return value.ValueKind == JsonValueKind.String ? value.GetString() : null;
    }

    private string? ReadDescription()
    {
        if (workRecord?.RootElement.TryGetProperty("description", out var value) != true)
        {
            return null;
        }

        // Open Library descriptions can be plain text or an object with a value field.
        if (value.ValueKind == JsonValueKind.String)
        {
            return value.GetString();
        }

        if (value.ValueKind == JsonValueKind.Object &&
            value.TryGetProperty("value", out var description) &&
            description.ValueKind == JsonValueKind.String)
        {
            return description.GetString();
        }

        return null;
    }

    private List<string> ReadStringArray(string propertyName)
    {
        if (workRecord?.RootElement.TryGetProperty(propertyName, out var value) != true ||
            value.ValueKind != JsonValueKind.Array)
        {
            return [];
        }

        return value.EnumerateArray()
            .Where(item => item.ValueKind == JsonValueKind.String)
            .Select(item => item.GetString()!)
            .ToList();
    }

    private List<int> ReadIntegerArray(string propertyName)
    {
        if (workRecord?.RootElement.TryGetProperty(propertyName, out var value) != true ||
            value.ValueKind != JsonValueKind.Array)
        {
            return [];
        }

        return value.EnumerateArray()
            .Where(item => item.ValueKind == JsonValueKind.Number && item.TryGetInt32(out _))
            .Select(item => item.GetInt32())
            .ToList();
    }
}
